{
  "name": "realtor-parcel-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/trace-next-runtime.mjs && next build && node scripts/verify-deployment-bundle.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:schema": "tsx scripts/apply-schema.ts db/schema.sql",
    "db:compact": "tsx scripts/compact-parcel-storage.ts",
    "db:seed": "tsx scripts/apply-schema.ts db/seed.sql",
    "parcels:fetch": "tsx scripts/fetch-arcgis-layer.ts",
    "parcels:import": "tsx scripts/import-parcels-from-geojson.ts",
    "parcels:export-static": "tsx scripts/export-static-parcels.ts",
    "parcels:build-search": "tsx scripts/build-parcel-search.ts",
    "parcels:benchmark": "tsx scripts/benchmark-parcels.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:static": "tsx --test tests/static-parcels.test.ts",
    "parcels:prune": "tsx scripts/prune-static-parcels.ts",
    "parcels:restore": "tsx scripts/restore-static-parcels.ts",
    "parcels:verify-static": "tsx scripts/verify-static-parcels.ts",
    "test:ui": "node --import tsx --test tests/parcel-presentation.test.ts"
  },
  "dependencies": {
    "@turf/turf": "latest",
    "dotenv": "latest",
    "geojson-vt": "^5.0.2",
    "maplibre-gl": "latest",
    "next": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "vt-pbf": "^3.1.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@types/geojson": "latest",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/vt-pbf": "^3.1.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "proj4": "^2.20.8",
    "tsx": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": "24.x"
  }
}
